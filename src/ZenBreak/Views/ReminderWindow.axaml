<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZenBreak.ViewModels"
        x:Class="ZenBreak.Views.ReminderWindow"
        x:DataType="vm:MainViewModel"
        Title="Time for a Break!"
        Width="380" Height="270"
        WindowStartupLocation="Manual"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SystemDecorations="BorderOnly"
        Background="#FF1E1E2E">
    
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#FF89B4FA"/>
            <Setter Property="Foreground" Value="#FF1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#FF45475A"/>
            <Setter Property="Foreground" Value="#FFCDD6F4"/>
        </Style>
    </Window.Styles>
    
    <Border CornerRadius="12" Background="#FF1E1E2E" Padding="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            
            <!-- Icon/Emoji -->
            <TextBlock Text="⏰" FontSize="26" HorizontalAlignment="Center"/>
            
            <!-- Title -->
            <TextBlock Text="Time for a Break!" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="#FFCDD6F4"
                       HorizontalAlignment="Center"/>
            
            <!-- Continuous Working Duration Badge -->
            <Border Background="#FF313244" CornerRadius="6" Padding="12,6" HorizontalAlignment="Center">
                <TextBlock Text="{Binding WorkingDurationText}" 
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="#FFF9E2AF"
                           HorizontalAlignment="Center"/>
            </Border>
            
            <!-- Subtitle -->
            <TextBlock Text="Stand up, stretch, and hydrate!" 
                       FontSize="13" 
                       Foreground="#FFA6ADC8"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="320"/>
            
            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button Classes="primary" Content="Take Break" Click="OnTakeBreakClick"/>
                <Button Classes="secondary" Content="Later (5m)" Click="OnSnoozeClick"/>
                <Button Classes="secondary" Content="Skip" Click="OnSkipClick"/>
            </StackPanel>
            
        </StackPanel>
    </Border>
</Window>
